# Másold .env néven, és töltsd ki. A .env fájlt SOHA ne töltsd fel git-be (a .gitignore kizárja).

# A bot tokenje: Discord Developer Portal -> az alkalmazásod -> Bot -> Reset Token.
# Ez az EGYETLEN hely, ahol a token szerepel. Idézőjel és "Bot " előtag nélkül írd be.
DISCORD_TOKEN=<tokened-helye_a1b2c3d4e5f6g7h8i9>

# --- Opcionális beállítások ---
# Egyetlen szerver ID-ja: ide azonnal szinkronizálódnak a parancsok (fejlesztéshez/teszteléshez).
# Üresen hagyva globálisan regisztrálja őket (ez néhány percet késhet).
#GUILD_ID=

# ffmpeg útvonala, ha nem a PATH-on van (egyébként automatikusan megkeresi / a beépített példányt használja).
#FFMPEG_PATH=

# Ennyi másodperc üresjárat után lép ki a bot a hangcsatornából (5-3600, alapértelmezés: 60).
#IDLE_TIMEOUT=60

# Szerverenként legfeljebb ennyi hang várakozhat a sorban (1-50, alapértelmezés: 10).
#MAX_QUEUE=10

# DEBUG, INFO, WARNING, ERROR vagy CRITICAL (alapértelmezés: INFO).
#LOG_LEVEL=INFO
